n1 = float(input('Введите число: '))
n2 = float(input('Введите число: '))
oper = str(input('Введите оператор: +, -, *, /: '))
res = 0
if oper == '+':
    res = n1 + n2
elif oper == '-':
    res = n1 - n2
elif oper == '*':
    res = n1 * n2
elif oper == '/':
    res = n1/n2
else:
    print('Ошибка')
print(res)
