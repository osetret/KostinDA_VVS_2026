
def lvl1():
    a = "пРиВет МИР"
    print("Методы:")
    print(f"1: Увеличение всех элементов строки: {a} ->{a.upper()}")
    print(f"2: Уменьшение всех элементов строки: {a} ->{a.lower()}")
    print(f"3: Первый элемент остается большим остальные маленький{a} ->{a.capitalize()}")
    method = str(input("выберите применяемый метод 1, 2, 3: "))

    if method in ("1", "upper"):
        print("Введите стороку")
        sr = str(input("Ваша строка: "))
        print(f"{sr} ->{sr.upper()}")
    elif method in ("2", "lower"):
        print("Введите стороку")
        sr = str(input("Ваша строка: "))
        print(f"{sr} ->{sr.lower()}")
    elif method in ("3", "capitalsize"):
        print("Введите стороку")
        sr = str(input("Ваша строка: "))
        print(f"{sr} ->{sr.capitalize()}")
    else:
        print("Вы выбрали неверный метод")

def lvl2():
    a="Ботать это круто. Очень круто"
    print("Методы:")
    print(f"1: Поиск первого вхождения слова в строку.")
    print(f"Пример: слово-круто, строка- {a} -> {a.find('круто')}")
    print(f"2: заменить слово в строке на другое слово.")
    print(f" Пример слово- круто, второе слово-плохо, строка-{a}-> {a.replace('круто','плохо')}")
    print("3: Подсчет всех элементов")
    print(f"Пример: буква-о, строка-{a} ->{a.count('o')}")
    method = str(input("выберите применяемый метод 1, 2, 3: "))
    if method=='1':
        print("Введите стороку")
        sr = str(input("Ваша строка: "))
        print("Введите слово")
        wr =str(input("Ваше слово: "))
        if sr.find(wr)!=-1:
            print(f"{sr},{wr} -> {sr.find(wr)}")
        else:
            print("Такого элемента в строке нет")
    elif method=="2":
        print("Введите стороку")
        sr = str(input("Ваша строка: "))
        print("Введите заменяемое слово")
        wr1 = str(input("Ваше слово: "))
        print("Введите новое слово")
        wr2 = str(input("Ваше слово: "))
        if sr.find(wr1)!=-1:
            print(f"{sr},{wr1},{wr2} -> {sr.replace(wr1,wr2)}")
        else:
            print("Такого элемента в строке нет")
    elif method=='3':
        print("Введите стороку")
        sr = str(input("Ваша строка: "))
        print("Введите элемент")
        wr = str(input("Ваш элемент: "))
        print(f"{sr},{wr}-> {sr.count(wr)}")
    else:
        print("Вы выбрали неверный метод")
